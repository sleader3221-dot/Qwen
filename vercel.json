{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm install",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 512
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/ws/(.*)", "dest": "/api/index.py" },
    { "src": "/api/docs(.*)", "dest": "/api/index.py" },
    { "src": "/api/redoc(.*)", "dest": "/api/index.py" },
    { "src": "/openapi.json", "dest": "/api/index.py" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "env": {
    "PYTHONUNBUFFERED": "1"
  },
  "github": {
    "silent": true,
    "autoJobCancel": true
  }
}
