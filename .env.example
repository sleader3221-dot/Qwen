# ─── Required ──────────────────────────────────────────────
# Get your API key at https://www.qwencloud.com
DASHSCOPE_API_KEY=sk-your-qwen-cloud-api-key

# ─── Database ──────────────────────────────────────────────
# Local dev:     sqlite:///./autopilot.db
# Vercel (demo): sqlite:////tmp/autopilot.db
# Production:    postgresql://user:pass@host:5432/autopilot
DATABASE_URL=sqlite:///./autopilot.db

# ─── Security ──────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-string

# ─── Optional Integrations ─────────────────────────────────
SENDGRID_API_KEY=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ─── Alibaba Cloud (optional) ──────────────────────────────
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_OSS_BUCKET=

# ─── Vercel Deploy Settings (set in Vercel Dashboard) ─────
# DASHSCOPE_API_KEY     : Required for Qwen Cloud AI
# DATABASE_URL          : Defaults to sqlite:////tmp/autopilot.db
# SECRET_KEY            : Random string for session security
# ENABLE_THINKING_MODE  : "True" (default) or "False"
# ENABLE_WEB_SEARCH     : "True" (default) or "False"
# ENABLE_CODE_INTERPRETER : "True" (default) or "False"
# ENABLE_HUMAN_IN_LOOP  : "True" (default) or "False"
# CONFIDENCE_THRESHOLD  : 0.85 (default)
# MAX_RETRY_ATTEMPTS    : 3 (default)
